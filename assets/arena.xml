<mujoco model="eurobot_arena">
  <option timestep="0.01" integrator="RK4"/>
  <size nconmax="200" njmax="500"/>
  <asset>
    <texture name="texplane" type="2d" builtin="checker" width="512" height="512" rgb1="0.9 0.9 0.9" rgb2="0.85 0.85 0.85"/>
    <material name="matplane" texture="texplane" texrepeat="3 2" reflectance="0.1"/>
    <material name="matblue" rgba="0.2 0.4 1 1"/>
    <material name="matyellow" rgba="1 0.9 0.2 1"/>
    <material name="matcrate" rgba="0.6 0.4 0.2 1"/>
    <material name="matzone" rgba="0.2 1 0.2 0.2"/>
    <material name="matnest" rgba="0.2 0.8 0.2 0.4"/>
    <material name="matcursor" rgba="1 0.2 0.2 0.3"/>
    <material name="matborder" rgba="0.2 0.2 0.2 1"/>
  </asset>
  <worldbody>
    <!-- Table 3x2 m -->
    <geom name="floor" type="plane" size="10 10 0.1" material="matplane" friction="1.0 0.005 0.0001"/>
    <!-- Borders as boxes (70mm height) -->
    <geom name="border_xp" type="box" pos="1.5 0 0.035" size="0.01 1.0 0.035" material="matborder"/>
    <geom name="border_xn" type="box" pos="-1.5 0 0.035" size="0.01 1.0 0.035" material="matborder"/>
    <geom name="border_yp" type="box" pos="0 1.0 0.035" size="1.5 0.01 0.035" material="matborder"/>
    <geom name="border_yn" type="box" pos="0 -1.0 0.035" size="1.5 0.01 0.035" material="matborder"/>

    <!-- Pantries (200x200mm) as transparent boxes on floor -->
    <geom name="pantry_A" type="box" pos="0.8 0.6 0.001" size="0.1 0.1 0.001" material="matzone" contype="0" conaffinity="0"/>
    <geom name="pantry_B" type="box" pos="-0.8 0.6 0.001" size="0.1 0.1 0.001" material="matzone" contype="0" conaffinity="0"/>
    <geom name="pantry_C" type="box" pos="0.8 -0.6 0.001" size="0.1 0.1 0.001" material="matzone" contype="0" conaffinity="0"/>
    <geom name="pantry_D" type="box" pos="-0.8 -0.6 0.001" size="0.1 0.1 0.001" material="matzone" contype="0" conaffinity="0"/>
    <!-- Nests (450x600mm) simplified as boxes -->
    <geom name="nest_blue" type="box" pos="-1.125 -0.7 0.001" size="0.225 0.3 0.001" material="matnest" contype="0" conaffinity="0"/>
    <geom name="nest_yellow" type="box" pos="1.125 0.7 0.001" size="0.225 0.3 0.001" material="matnest" contype="0" conaffinity="0"/>

    <!-- Cursor strip (front edge), simplified region -->
    <geom name="cursor_band" type="box" pos="0 -0.95 0.001" size="1.2 0.02 0.001" material="matcursor" contype="0" conaffinity="0"/>

    <!-- Blue robot (cylinder) -->
    <body name="blue" pos="-1.0 -0.5 0.03">
      <geom type="cylinder" size="0.12 0.03" material="matblue" friction="1.0 0.01 0.0001"/>
      <joint name="blue_x" type="slide" axis="1 0 0"/>
      <joint name="blue_y" type="slide" axis="0 1 0"/>
      <joint name="blue_yaw" type="hinge" axis="0 0 1"/>
      <site name="blue_grip" pos="0.13 0 0.03" size="0.005" rgba="0 0 1 1"/>
    </body>

    <!-- Yellow robot (cylinder) -->
    <body name="yellow" pos="1.0 0.5 0.03">
      <geom type="cylinder" size="0.12 0.03" material="matyellow" friction="1.0 0.01 0.0001"/>
      <joint name="yellow_x" type="slide" axis="1 0 0"/>
      <joint name="yellow_y" type="slide" axis="0 1 0"/>
      <joint name="yellow_yaw" type="hinge" axis="0 0 1"/>
      <site name="yellow_grip" pos="0.13 0 0.03" size="0.005" rgba="1 1 0 1"/>
    </body>

    <!-- Crates (150x50x30mm) approximated as 0.15x0.05x0.03 m boxes -->
    <!-- 8 crates; more can be spawned in reset -->
    <body name="crate0" pos="-0.2 0 0.015"><geom type="box" size="0.075 0.025 0.015" material="matcrate" friction="0.9 0.01 0.0001"/></body>
    <body name="crate1" pos="0.2 0 0.015"><geom type="box" size="0.075 0.025 0.015" material="matcrate" friction="0.9 0.01 0.0001"/></body>
    <body name="crate2" pos="0 0.4 0.015"><geom type="box" size="0.075 0.025 0.015" material="matcrate"/></body>
    <body name="crate3" pos="0 -0.4 0.015"><geom type="box" size="0.075 0.025 0.015" material="matcrate"/></body>
    <body name="crate4" pos="-0.6 0.3 0.015"><geom type="box" size="0.075 0.025 0.015" material="matcrate"/></body>
    <body name="crate5" pos="0.6 -0.3 0.015"><geom type="box" size="0.075 0.025 0.015" material="matcrate"/></body>
    <body name="crate6" pos="-0.6 -0.3 0.015"><geom type="box" size="0.075 0.025 0.015" material="matcrate"/></body>
    <body name="crate7" pos="0.6 0.3 0.015"><geom type="box" size="0.075 0.025 0.015" material="matcrate"/></body>
  </worldbody>
  <actuator>
    <!-- We'll control (v, ω) via position targets on slide + hinge with a small PD loop in Python -->
    <position name="blue_x_act" joint="blue_x" kp="20"/>
    <position name="blue_y_act" joint="blue_y" kp="20"/>
    <position name="blue_yaw_act" joint="blue_yaw" kp="10"/>
    <position name="yellow_x_act" joint="yellow_x" kp="20"/>
    <position name="yellow_y_act" joint="yellow_y" kp="20"/>
    <position name="yellow_yaw_act" joint="yellow_yaw" kp="10"/>
  </actuator>
</mujoco>
